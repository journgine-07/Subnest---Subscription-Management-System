PORT=5000
TZ=Asia/Kolkata
# Local MongoDB (or paste an Atlas connection string)
MONGO_URI=mongodb://127.0.0.1:27017/subscription_management
# REQUIRED: a long random string (32+ characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
# Where the React app runs (used for CORS and the password-reset link)
CLIENT_URL=http://localhost:5173
# Only when running behind a reverse proxy/load balancer (e.g. 1)
TRUST_PROXY=
# Set to true to let this server also serve the built React app (after `npm run build`)
SERVE_CLIENT=false
# SMTP for password-reset and invoice emails. Leave blank in development:
# the reset link is then printed in the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Brightloop <no-reply@example.com>"
